TYPE=TRIGGERS
triggers='CREATE DEFINER=`root`@`localhost` TRIGGER `trg_users_prevent_zero_admin_update` BEFORE UPDATE ON `users` FOR EACH ROW BEGIN\n  DECLARE v_admin_role_id INT;\n  DECLARE v_admin_count   INT;\n\n  SELECT id INTO v_admin_role_id\n  FROM roles\n  WHERE role_code = \'ADMIN\'\n  LIMIT 1;\n\n  -- Nếu user đang là Admin và định chuyển sang role khác (kể cả NULL)\n  IF OLD.role_id = v_admin_role_id\n     AND (NEW.role_id IS NULL OR NEW.role_id <> v_admin_role_id) THEN\n\n     SELECT COUNT(*) INTO v_admin_count\n     FROM users\n     WHERE role_id = v_admin_role_id;\n\n     -- Nếu hiện tại chỉ còn đúng 1 Admin (chính người này) => chặn\n     IF v_admin_count <= 1 THEN\n        SIGNAL SQLSTATE \'45000\'\n          SET MESSAGE_TEXT = \'Hệ thống phải có ít nhất 1 Admin. Không thể hạ cấp Admin cuối cùng.\';\n     END IF;\n  END IF;\nEND' 'CREATE DEFINER=`root`@`localhost` TRIGGER `trg_users_prevent_zero_admin_delete` BEFORE DELETE ON `users` FOR EACH ROW BEGIN\n  DECLARE v_admin_role_id INT;\n  DECLARE v_admin_count   INT;\n\n  SELECT id INTO v_admin_role_id\n  FROM roles\n  WHERE role_code = \'ADMIN\'\n  LIMIT 1;\n\n  IF OLD.role_id = v_admin_role_id THEN\n     SELECT COUNT(*) INTO v_admin_count\n     FROM users\n     WHERE role_id = v_admin_role_id;\n\n     IF v_admin_count <= 1 THEN\n        SIGNAL SQLSTATE \'45000\'\n          SET MESSAGE_TEXT = \'Hệ thống phải có ít nhất 1 Admin. Không thể xóa Admin cuối cùng.\';\n     END IF;\n  END IF;\nEND'
sql_modes=524288 524288
definers='root@localhost' 'root@localhost'
client_cs_names='utf8mb4' 'utf8mb4'
connection_cl_names='utf8mb4_general_ci' 'utf8mb4_general_ci'
db_cl_names='utf8mb4_general_ci' 'utf8mb4_general_ci'
